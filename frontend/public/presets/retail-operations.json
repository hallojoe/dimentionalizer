      "from": "purchase",
      "to": "fulfill",
      "label": "Starts",
      "direction": "forward"
    },
    {
      "id": "link-7",
      "from": "warehouse",
      "to": "stock",
      "label": "Holds",
      "direction": "forward"
    },
    {
      "id": "link-8",
      "from": "fulfill",
