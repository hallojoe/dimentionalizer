          "id": "step-1",
          "text": "Find request and attempt identifiers.",
          "done": false
        },
        {
          "id": "step-2",
          "text": "Follow instance and dependency spans.",
          "done": false
        },
        {
          "id": "step-3",
          "text": "Record a reproducible next action.",
          "done": false
        }
      ]
    }
