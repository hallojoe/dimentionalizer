      "type": "event",
      "group": "decision",
      "elevation": 0.0,
      "description": "Record approval, conditions, or decline with a clear next step.",
      "checklist": [
        {
          "id": "step-1",
          "text": "Record the decision and rationale.",
          "done": false
        },
        {
          "id": "step-2",
          "text": "Name the owner of the next step.",
          "done": false
