      "type": "workflow",
      "group": "failures",
      "elevation": 0.0,
      "description": "Decide whether another attempt is appropriate.",
      "checklist": [
        {
          "id": "step-1",
          "text": "Check whether the operation is safe to retry.",
          "done": false
        },
        {
          "id": "step-2",
          "text": "Define an attempt limit and delay.",
          "done": false
        },
        {
          "id": "step-3",
          "text": "Keep the same correlation context.",
          "done": false
        }
      ]
    },
    {
      "id": "dead-letter",
      "name": "Exhausted work",
      "type": "queue",
      "group": "failures",
      "elevation": -4.0,
      "description": "Retain failed work for investigation after attempts are exhausted."
    },
    {
      "id": "trace",
      "name": "Trace and investigation",
      "type": "storage",
      "group": "failures",
      "elevation": 2.0,
      "description": "Evidence to explain the path across instances.",
