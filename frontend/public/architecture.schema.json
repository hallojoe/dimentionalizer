{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimentionalizer architecture v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "groups",
    "objects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "presentation": {
      "type": "object",
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [],
      "properties": {
        "showNames": {
          "type": "boolean"
        },
        "effects": {
          "type": "boolean"
        },
        "autoOrbit": {
          "type": "boolean"
        },
        "showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Show the ground reference grid; group platforms remain visible."
        },
        "showPlaneFrames": {
          "type": "boolean",
          "default": true
        },
        "showGroupFrames": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "default": 0,
            "description": "Signed group elevation relative to its parent plane."
          },
          "plane": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Parent plane ID; omitted uses the first plane."
          },
          "spacing": {
            "$ref": "#/$defs/spacing"
          },
          "visible": {
            "type": "boolean",
            "default": true,
            "description": "Hide this entity and its descendants without changing layout."
          },
          "showFrame": {
            "type": "boolean",
            "default": true,
            "description": "Show surface, border, grid and heading when the corresponding global frame setting is enabled. Contents remain visible."
          }
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "default": "container",
            "description": "Built-in or custom objectTypes ID. Omitted defaults to container; unknown IDs retain identity and fall back to container."
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "default": 0,
            "description": "Signed object elevation relative to its group."
          },
          "linkedSpace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Click the object to enter this other space."
          },
          "spacing": {
            "allOf": [
              {
                "$ref": "#/$defs/spacing"
              },
              {
                "properties": {
                  "target": {
                    "const": "self"
                  }
                }
              }
            ]
          },
          "checklist": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "done": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "visible": {
            "type": "boolean",
            "default": true,
            "description": "Hide this entity and its descendants without changing layout."
          }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "from": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "space",
                      "plane",
                      "group",
                      "object"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            ]
          },
          "to": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "space",
                      "plane",
                      "group",
                      "object"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 10000
          },
          "direction": {
            "enum": [
              "forward",
              "bidirectional"
            ],
            "default": "forward"
          },
          "style": {
            "enum": [
              "normal",
              "lightning",
              "wobbly"
            ],
            "default": "normal"
          },
          "capacity": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "in"
                ]
              },
              {
                "required": [
                  "out"
                ]
              }
            ],
            "properties": {
              "in": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              "out": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              "unit": {
                "type": "string",
                "maxLength": 40,
                "default": ""
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "planes": {
      "type": "array",
      "maxItems": 50,
      "description": "Omitted: an auto-fit default plane at world zero. Groups without plane use the first plane.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000,
            "default": 20
          },
          "height": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000,
            "default": 20
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "default": 0
          },
          "sizing": {
            "enum": [
              "auto",
              "locked"
            ],
            "default": "auto"
          },
          "decoration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.025
              },
              "border": {
                "type": "boolean",
                "default": true
              },
              "grid": {
                "type": "boolean",
                "default": false
              },
              "label": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "space": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Parent space ID; omitted uses the first space."
          },
          "spacing": {
            "$ref": "#/$defs/spacing"
          },
          "visible": {
            "type": "boolean",
            "default": true,
            "description": "Hide this entity and its descendants without changing layout."
          },
          "showFrame": {
            "type": "boolean",
            "default": true,
            "description": "Show surface, border, grid and heading when the corresponding global frame setting is enabled. Contents remain visible."
          }
        }
      }
    },
    "objectTypes": {
      "type": "array",
      "maxItems": 50,
      "description": "Custom semantic types; omit for built-ins only. Built-in IDs cannot be overridden.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "default": "\u25c7"
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "shape": {
            "enum": [
              "container",
              "database",
              "email",
              "cache",
              "reverse-proxy",
              "queue",
              "storage",
              "cdn",
              "user",
              "usergroup",
              "event",
              "product",
              "shop",
              "warehouse",
              "workflow",
              "request",
              "response",
              "processing",
              "webhook",
              "api-call",
              "dataflow",
              "message",
              "human",
              "family",
              "adult",
              "child",
              "food",
              "bed",
              "shower",
              "toilet",
              "sofa",
              "chair",
              "desk",
              "wall",
              "window-wall",
              "bus",
              "train",
              "airplane",
              "office",
              "home"
            ],
            "default": "container"
          },
          "model": {
            "type": "object",
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2000,
                "description": "Relative asset path or HTTPS URL ending in .glb/.gltf; self-contained glTF 2.0 static mesh."
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "default": [
                  0,
                  0,
                  0
                ],
                "description": "X/Y/Z angles in degrees, applied before auto-fit."
              }
            }
          }
        }
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "spacing": {
            "$ref": "#/$defs/spacing"
          }
        }
      }
    },
    "spaceView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "active": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "spacing": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "margin",
            "padding"
          ],
          "default": "margin"
        },
        "target": {
          "enum": [
            "self",
            "children"
          ],
          "default": "self"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Extra horizontal scene units per side, beyond the baseline layout."
        }
      }
    }
  }
}
