{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dimentionalizer architecture v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "groups",
    "objects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "presentation": {
      "type": "object",
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [],
      "properties": {
        "showNames": {
          "type": "boolean"
        },
        "effects": {
          "type": "boolean"
        },
        "autoOrbit": {
          "type": "boolean"
        },
        "showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Show the ground reference grid; group platforms remain visible."
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "default": 0,
            "description": "Signed group elevation relative to its parent plane."
          },
          "plane": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Parent plane ID; omitted uses the first plane."
          }
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "default": "container",
            "description": "Predefined: container, database, email, cache, reverse-proxy, queue, storage, cdn. Unknown IDs fall back to container."
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "default": 0,
            "description": "Signed object elevation relative to its group."
          }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "from": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "plane",
                      "group",
                      "object"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            ]
          },
          "to": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "plane",
                      "group",
                      "object"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 10000
          },
          "direction": {
            "enum": [
              "forward",
              "bidirectional"
            ],
            "default": "forward"
          }
        },
        "additionalProperties": false
      }
    },
    "planes": {
      "type": "array",
      "maxItems": 50,
      "description": "Omitted: an auto-fit default plane at world zero. Groups without plane use the first plane.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000,
            "default": 20
          },
          "height": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000,
            "default": 20
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "default": 0
          },
          "sizing": {
            "enum": [
              "auto",
              "locked"
            ],
            "default": "auto"
          },
          "decoration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.025
              },
              "border": {
                "type": "boolean",
                "default": true
              },
              "grid": {
                "type": "boolean",
                "default": false
              },
              "label": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
